# Example environment file for local/server setup.
# Copy this file to .env and replace placeholder values.
# Do not put real secrets in .env.example.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=myapp

DATABASE_URL=postgresql://postgres:change_me_postgres_password@db:5432/myapp
JWT_SECRET=change_me_use_a_long_random_secret_value
